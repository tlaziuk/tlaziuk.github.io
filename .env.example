# Site identity. Leave the optional link variables unset to hide that link.
APP_NAME=Tomek Łaziuk
APP_EMAIL=
APP_GITHUB_URL=
APP_TWITTER_URL=
APP_LINKEDIN_URL=

# Absolute origin used for canonical links, robots.txt and the sitemap.
# Falls back to the origin of the incoming request when unset.
APP_URL=

# Meta description used by search engines and link previews.
APP_DESCRIPTION=

# Optional. The container reads the revision from git metadata on its own.
# GIT_REVISION overrides it (e.g. for deploys without git history).
# BUILD_TIMESTAMP is an ISO 8601 instant or epoch milliseconds; defaults to the
# time the server starts.
# GIT_REVISION=
# BUILD_TIMESTAMP=
