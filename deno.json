{
  "nodeModulesDir": "manual",
  "fmt": {
    "exclude": [
      "LICENSE.md"
    ]
  },
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve --env-file -A _fresh/server.js",
    "check": "deno fmt --check . && deno lint . && deno check"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@fontsource-variable/roboto": "npm:@fontsource-variable/roboto@^5.3.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@iconify-json/mdi": "npm:@iconify-json/mdi@^1.2.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "types": [
      "vite/client"
    ],
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  }
}
